# Database (Use Supabase connection pooler on port 5432 or 6543 for IPv4 cloud compatibility like Render)
DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Groq API
GROQ_API_KEY=your-groq-api-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=ipcai-pdfs
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# App
APP_NAME=IPC.ai
DEBUG=true
